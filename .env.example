# Copy this file to .env. Never commit the real .env file.
STYLEPILOT_SEMANTIC_PROVIDER=openai
STYLEPILOT_VLM_API_KEY=
STYLEPILOT_VLM_MODEL=gpt-5.6-luna
STYLEPILOT_VLM_API_MODE=responses
STYLEPILOT_VLM_PROMPT_FILE=.stylepilot/prompts/scene-analysis.json

# Only set this for a verified OpenAI-compatible endpoint.
# STYLEPILOT_VLM_BASE_URL=https://api.example.com/v1

# Qianwen AI Platform preset:
# STYLEPILOT_SEMANTIC_PROVIDER=qianwen
# STYLEPILOT_VLM_MODEL=qwen3.7-plus
# STYLEPILOT_VLM_API_MODE=chat_completions
# STYLEPILOT_VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
